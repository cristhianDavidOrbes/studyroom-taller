{
  "name": "studyroom",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @studyroom/api\" \"npm run dev -w @studyroom/web\"",
    "dev:ai": "npm run dev -w @studyroom/ai-gateway",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node apps/web/tests/browser-smoke.mjs",
    "emulators": "npx -y firebase-tools@15.32.1 emulators:start --only auth --project demo-studyroom",
    "traceability": "node scripts/traceability.mjs",
    "test:media": "node apps/web/tests/media-collaboration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "9.2.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "deepmerge-ts": "8.0.0",
    "esbuild": "0.28.1",
    "js-yaml": "5.4.2",
    "uuid": "11.1.1"
  }
}
