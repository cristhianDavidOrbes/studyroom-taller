{
  "name": "@studyroom/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.7",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.117.2",
    "docx": "9.11.0",
    "dotenv": "17.2.3",
    "firebase-admin": "14.5.0",
    "helmet": "8.1.0",
    "jszip": "3.10.2",
    "livekit-server-sdk": "2.19.1",
    "mammoth": "1.13.0",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "yauzl": "3.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.11",
    "@types/pdf-parse": "1.1.5",
    "@types/yauzl": "3.4.0",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "ts-jest": "29.4.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "maxWorkers": 1
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
