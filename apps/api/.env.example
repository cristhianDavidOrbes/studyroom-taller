NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Local PostgreSQL. Use a dedicated least-privilege login and verified TLS in production.
DATABASE_URL=postgresql://studyroom:replace-local-password@127.0.0.1:54322/studyroom?schema=public&connection_limit=3
DIRECT_URL=postgresql://studyroom:replace-local-password@127.0.0.1:54322/studyroom?schema=public
FIREBASE_PROJECT_ID=demo-studyroom
# Remove this variable entirely in production. Production refuses emulator tokens.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Production: JSON of dedicated Firebase Authentication Admin service account.
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=studyroom-files
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Development only: loopback HTTP. Render must use the HTTPS ngrok free domain.
AI_GATEWAY_URL=http://127.0.0.1:8787
AI_GATEWAY_TOKEN=
