# Generate a unique secret using scripts/local-ai/setup.ps1. Never use this placeholder.
AI_GATEWAY_SECRET=replace_with_a_random_64_character_secret
AI_GATEWAY_PORT=8787
AI_REQUEST_TIMEOUT_MS=120000
AI_REQUESTS_PER_MINUTE=12
AI_MONTHLY_REQUEST_LIMIT=18000
AI_MONTHLY_BYTE_LIMIT=900000000
AI_QUEUE_LIMIT=8
AI_MIN_FREE_MEMORY_MB=2048
AI_CPU_THREADS=2
# Fixed local model: qwen3:4b-instruct; context 4096; maximum output 1024 tokens.
# Persistent usage and pause state; path relative to this app directory.
AI_STATE_DIR=.local
